#
#This file is written to easily introduce a new rookie to develop input files for BigDFT.
#In the same directory of this guide there are example files to better understand what an input file looks like.
#All the examples works after compiling BigDFT and PyBigDFT and runs both in python and jupyter-notebook.
#
#After typing "python example.py" the script will always generate a blank *yaml file called BigDFT_log.yaml
#
#Some command line used in PyBigDFT are available only via Jupyter-notebook as the visualizer. 
#Example:
#
#   from BigDFT.Visualization import InlineVisualizer
#   viz = InlineVisualizer(500,400)
#   viz.display_system(sys)
#
#
#
#There are two main way to generate an input file:
#          1° Use a program with a defined gui --> Ex.: Avogadro ---> export file with xyz extension. --> bigdft will automatically assume angstroem unit
#             1.5° Add the xyz file into /build-dir/PyBigDFT/lib/BigDFT/Database/XYZs  --> now the xyz file may be choose while writing an input file
#
#  Example: from BigDFT.Systems import System
#           from BigDFT.Fragments import Fragments
#           from BigDFT.IO import XYZReader
#
#           N2 = Systems()
#           with XYZReader("N2") as ifile:   ----> In this case the N2 molecule is taken from /PyBigDFT/BigDFT/Database/XYZs
#           N2["N:0"] = Fragment([next(ifile)]) ----> Two N2 molecules are add into the environment called N:0 and N:1
#           N2["N:1"] = Fragment([next(ifile)])
#
#
#          2° Type manually the system's structure 
#
#
#
#Let's generate an atom!
#
#   from BigDFT.Atoms import Atom
#   at = Atom({'r':[1.0, 0.0, 0.0], 'sym':"He", 'units': 'bohr'})
#   print(dict(at))
#
#This command prints what is written after *at* --> distances, atom symbol and Bohr radius (= GS of orbital in H atom).
#
#Any supplementary information may be displayed as:
#   at["source"] = "tutorial"
#   print(dict(at))
#
#   print(at.get_position())
#   print(at.get_position(units="angstroem"))  --> converts Bohr coordinates in angstroem 
#   at.set_position([1.0, 1.0, 1.0], units="angstroem")
#   print(at.get_position(units="angstroem"))  --> set coordinates to angstroem
#
#To see how is an basis input file look at **he.py**
#
#
#As general rule PyBigDFT doesn't know the total electron (e-) number of a system <-- *Pseudopotential approximation*.
#The total numer of e- depend on our chosen pseudopot. but we can set this ourself.
#Example: 
#   at.nel = 2 ----> This line sets the total numer of valence e-
#   print(at.nel)
#
#
#U may add other flags to further describe a system as:
#
#   from BigDFT.IO import XYZReader  --> an XYZReader, search a possibile *.xyz in PyBigDFT 
#   from BigDFT.Systems import Systems  --> generate a system combining different fragments 
#   from BigDFT.Fragments import Fragments  --> Fragments generates atoms clustes as combination of 2 or more compounds
#  
#
#
